#!/usr/bin/env bash
#
# athena-server — SSH brute-force blocker (nftables backend)
# Part of Athena. Licensed under GPL-3.0.
#
# The daemon reads the journal (read-only), counts failed SSH logins per
# source address over a sliding window, and bans offenders with nftables.

# nft lives in sbin on most distributions; keep it reachable even when the
# daemon is started by hand from a non-root login shell.
PATH="${PATH:-/usr/local/bin:/usr/bin:/bin}:/usr/local/sbin:/usr/sbin:/sbin"
export PATH

TABLE_NAME=athena
SET_V4=athena_blacklist

CONF_FILE=${ATHENA_CONF:-/etc/athena/athena.conf}
FALLBACK_CONF=${ATHENA_FALLBACK_CONF:-./athena.conf}
VERSION_FILE=${ATHENA_VERSION_FILE:-/usr/share/athena/VERSION}
RUN_DIR=${ATHENA_RUN_DIR:-/run/athena}
STATE_DIR=${ATHENA_STATE_DIR:-/var/lib/athena}
STATE_FILE=$STATE_DIR/bans

# ip -> absolute expiry (epoch) of its ban, persisted across restarts.
# ip -> epoch until which a manually unbanned address is left alone.
declare -A BANS=()
declare -A GRACE=()
STATE_DIRTY=0

# Defaults; each of these can be overridden from athena.conf.
THRESHOLD=${THRESHOLD:-2}
BAN_TIME=${BAN_TIME:-3600}
FIND_TIME=${FIND_TIME:-600}
CHECK_INTERVAL=${CHECK_INTERVAL:-5}
WHITE_LIST=${WHITE_LIST:-"127.0.0.1"}
PORT_BLOCK=${PORT_BLOCK:-all}
# Syslog identifiers carrying sshd messages. OpenSSH >= 9.8 logs through
# sshd-session, older releases through sshd; repeated -t matches are ORed.
SSH_LOG_TAGS=${SSH_LOG_TAGS:-"sshd sshd-session"}

# ---------------------------------------------------------------------------
# Generic helpers
# ---------------------------------------------------------------------------

now() {
    local t
    printf -v t '%(%s)T' -1
    printf '%s' "$t"
}

log_event() {
    logger -t athena "$*" 2>/dev/null || printf '%s\n' "$*" >&2
}

athena_version() {
    local vf=$VERSION_FILE v=""
    if [[ ! -r $vf && -n ${BASH_SOURCE[0]:-} ]]; then
        vf="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/VERSION"
    fi
    [[ -r $vf ]] && IFS= read -r v < "$vf"
    printf '%s\n' "${v:-dev}"
}

# Prints the -t arguments expected by journalctl, one per SSH_LOG_TAGS entry.
journal_args() {
    local tag
    for tag in $SSH_LOG_TAGS; do
        printf -- '-t\n%s\n' "$tag"
    done
}

# ---------------------------------------------------------------------------
# Address helpers
# ---------------------------------------------------------------------------

is_ipv4() {
    local ip=$1 i
    local -a octets
    [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    octets=("${BASH_REMATCH[@]:1}")
    for i in "${octets[@]}"; do
        (( 10#$i <= 255 )) || return 1
    done
    return 0
}

# Expands an IPv6 address into the four 32-bit words of the global array W.
# Returns non-zero when the address is malformed.
ipv6_words() {
    local ip=$1 head tail fill i
    local -a lh=() lt=() h=()
    W=()

    [[ $ip == *:* && $ip =~ ^[0-9a-fA-F:]+$ ]] || return 1
    # At most one "::" (it stands for a whole run of zero hextets), and no
    # triple colon.
    [[ $ip == *::*::* || $ip == :::* || $ip == *::: ]] && return 1

    if [[ $ip == *::* ]]; then
        head=${ip%%::*}
        tail=${ip##*::}
        [[ $head == *::* || $tail == *::* ]] && return 1
    else
        head=$ip
        tail=""
    fi
    [[ -n $head ]] && IFS=: read -ra lh <<< "$head"
    [[ -n $tail ]] && IFS=: read -ra lt <<< "$tail"

    fill=$(( 8 - ${#lh[@]} - ${#lt[@]} ))
    (( fill >= 0 )) || return 1
    if [[ $ip != *::* ]] && (( fill != 0 )); then
        return 1
    fi

    h=("${lh[@]}")
    for (( i = 0; i < fill; i++ )); do h+=(0); done
    h+=("${lt[@]}")
    (( ${#h[@]} == 8 )) || return 1

    for i in "${h[@]}"; do
        [[ $i =~ ^[0-9a-fA-F]{1,4}$ ]] || return 1
    done

    W=(
        $(( (16#${h[0]} << 16) | 16#${h[1]} ))
        $(( (16#${h[2]} << 16) | 16#${h[3]} ))
        $(( (16#${h[4]} << 16) | 16#${h[5]} ))
        $(( (16#${h[6]} << 16) | 16#${h[7]} ))
    )
    return 0
}

is_ipv6() {
    ipv6_words "$1"
}

is_valid_address() {
    is_ipv4 "$1" || is_ipv6 "$1"
}

ipv4_to_int() {
    local a b c d
    IFS='.' read -r a b c d <<< "$1"
    printf '%s' $(( (10#$a << 24) + (10#$b << 16) + (10#$c << 8) + 10#$d ))
}

ip_in_cidr_v4() {
    local ip=$1 net prefix mask
    if [[ $2 != */* ]]; then
        [[ $ip == "$2" ]]
        return
    fi
    net=${2%/*}
    prefix=${2#*/}
    [[ $prefix =~ ^[0-9]{1,2}$ ]] || return 1
    (( prefix <= 32 )) || return 1
    is_ipv4 "$ip" && is_ipv4 "$net" || return 1
    if (( prefix == 0 )); then
        mask=0
    else
        mask=$(( (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF ))
    fi
    (( ( $(ipv4_to_int "$ip") & mask ) == ( $(ipv4_to_int "$net") & mask ) ))
}

ip_in_cidr_v6() {
    local ip=$1 net prefix i full rem mask
    local -a a b

    if [[ $2 != */* ]]; then
        ipv6_words "$ip" || return 1
        a=("${W[@]}")
        ipv6_words "$2" || return 1
        b=("${W[@]}")
        [[ ${a[*]} == "${b[*]}" ]]
        return
    fi
    net=${2%/*}
    prefix=${2#*/}
    [[ $prefix =~ ^[0-9]{1,3}$ ]] || return 1
    (( prefix <= 128 )) || return 1
    ipv6_words "$ip" || return 1
    a=("${W[@]}")
    ipv6_words "$net" || return 1
    b=("${W[@]}")

    full=$(( prefix / 32 ))
    rem=$(( prefix % 32 ))
    for (( i = 0; i < 4; i++ )); do
        if (( i < full )); then
            mask=4294967295
        elif (( i == full && rem > 0 )); then
            mask=$(( (0xFFFFFFFF << (32 - rem)) & 0xFFFFFFFF ))
        else
            mask=0
        fi
        (( (a[i] & mask) == (b[i] & mask) )) || return 1
    done
    return 0
}

ip_in_cidr() {
    if is_ipv4 "$1"; then
        ip_in_cidr_v4 "$1" "$2"
    else
        ip_in_cidr_v6 "$1" "$2"
    fi
}

is_whitelisted() {
    local ip=$1 cidr
    for cidr in $WHITE_LIST; do
        ip_in_cidr "$ip" "$cidr" && return 0
    done
    return 1
}

# Prints the source address of one journald message, or nothing when the
# message is not an SSH authentication failure. Field positions are not used:
# sshd appends an optional method suffix ("ssh2: RSA SHA256:…"), which shifts
# awk columns and used to make the daemon read the port as an address.
extract_ip() {
    local line=$1
    [[ $line == *Failed\ password* || $line == *Failed\ publickey* \
       || $line == *Failed\ keyboard-interactive* ]] || return 1
    [[ $line =~ from\ ([0-9a-fA-F.:]+)\ port\ [0-9]+ ]] || return 1
    printf '%s\n' "${BASH_REMATCH[1]}"
}

# ---------------------------------------------------------------------------
# nftables helpers
# ---------------------------------------------------------------------------

set_for_ip() {
    if is_ipv4 "$1"; then
        printf '%s' "$SET_V4"
    else
        return 1   # IPv6 banning is not wired yet
    fi
}

# True when the address already is an element of the set. Uses the exact
# element lookup: grepping `nft list set` matched 10.0.0.1 inside 10.0.0.10
# and silently refused to ban legitimate offenders.
set_contains() {
    local set=$1 ip=$2
    nft get element inet "$TABLE_NAME" "$set" "{ $ip }" >/dev/null 2>&1
}

init_firewall() {
    local -a ports=() sel=()
    local p idx

    log_event "[INFO] initialising nftables (port policy: $PORT_BLOCK)"
    nft add table inet "$TABLE_NAME" 2>/dev/null || true
    nft add set inet "$TABLE_NAME" "$SET_V4" \
        "{ type ipv4_addr; flags interval, timeout; }" 2>/dev/null || true
    nft add chain inet "$TABLE_NAME" input \
        "{ type filter hook input priority -100; policy accept; }" 2>/dev/null || true
    nft flush chain inet "$TABLE_NAME" input 2>/dev/null || true

    if [[ $PORT_BLOCK != all && -n $PORT_BLOCK ]]; then
        local -a rawports=()
        IFS=',' read -ra rawports <<< "$PORT_BLOCK"
        for p in "${rawports[@]}"; do
            p=${p// /}
            [[ -z $p ]] && continue
            if [[ ! $p =~ ^[0-9]+$ ]]; then
                log_event "[WARN] ignoring invalid port '$p' in PORT_BLOCK"
                continue
            fi
            ports+=("$p")
        done
    fi

    if (( ${#ports[@]} == 0 )); then
        nft add rule inet "$TABLE_NAME" input ip saddr "@$SET_V4" drop
    else
        for idx in "${!ports[@]}"; do
            (( idx > 0 )) && sel+=(",")
            sel+=("${ports[idx]}")
        done
        nft add rule inet "$TABLE_NAME" input ip saddr "@$SET_V4" \
            tcp dport "{" "${sel[@]}" "}" drop
        nft add rule inet "$TABLE_NAME" input ip saddr "@$SET_V4" \
            udp dport "{" "${sel[@]}" "}" drop
    fi
    log_event "[INFO] nftables ready"
}

ban_ip() {
    local ip=$1 set
    if ! set=$(set_for_ip "$ip"); then
        return 1
    fi
    is_whitelisted "$ip" && return 1

    # A manual unban wins over the failures still sitting in the window.
    if [[ -n ${GRACE[$ip]:-} ]]; then
        (( ${GRACE[$ip]} > $(now) )) && return 1
        unset "GRACE[$ip]"
    fi

    set_contains "$set" "$ip" && return 0
    # Log only once the kernel accepted the element: a failed `nft add` used
    # to leave a [BAN] line for an address that was never blocked.
    if nft add element inet "$TABLE_NAME" "$set" "{ $ip timeout ${BAN_TIME}s }" >/dev/null 2>&1; then
        BANS[$ip]=$(( $(now) + BAN_TIME ))
        STATE_DIRTY=1
        log_event "[BAN] $ip (for ${BAN_TIME}s)"
        return 0
    fi
    log_event "[WARN] failed to ban $ip"
    return 1
}

unban_ip() {
    local ip=$1 set
    if ! set=$(set_for_ip "$ip"); then
        log_event "[UNBAN] $ip (unsupported address family)"
        return 1
    fi
    if ! is_valid_address "$ip"; then
        log_event "[UNBAN] $ip (invalid address, ignored)"
        return 1
    fi

    # Whatever the outcome, the address is spared for a full finding window:
    # the failures that caused the ban are still in the journal, and the next
    # scan would ban it again a few seconds later.
    unset "BANS[$ip]"
    GRACE[$ip]=$(( $(now) + FIND_TIME ))
    STATE_DIRTY=1

    if nft delete element inet "$TABLE_NAME" "$set" "{ $ip }" >/dev/null 2>&1; then
        log_event "[UNBAN] $ip (Manual)"
        return 0
    fi
    log_event "[UNBAN] $ip (was not banned, ignored for ${FIND_TIME}s)"
    return 1
}

# Prints every source address that failed at least THRESHOLD times inside the
# finding window.
failed_sources() {
    local -a args=(journalctl -q --no-pager -o cat --since "-${FIND_TIME} seconds")
    local a
    while IFS= read -r a; do args+=("$a"); done < <(journal_args)
    "${args[@]}" 2>/dev/null \
        | grep -E 'Failed (password|publickey|keyboard-interactive)' \
        | sed -nE 's/.*from ([0-9a-fA-F.:]+) port [0-9]+.*/\1/p' \
        | awk -v limit="$THRESHOLD" '{ n[$1]++ } END { for (ip in n) if (n[ip] >= limit) print ip }'
}

process_unban_queue() {
    local queue=$RUN_DIR/unban_queue staging=$RUN_DIR/unban_queue.processing
    local lock=$RUN_DIR/unban_queue.lock fd ip
    [[ -s $queue ]] || return 0

    # The client appends under the same lock; the pending requests are moved
    # out of the way in one rename, so a request written between the read and
    # the truncation can no longer be lost.
    exec {fd}>>"$lock" || return 0
    if ! flock -x "$fd"; then
        exec {fd}>&-
        return 0
    fi
    if ! mv -f "$queue" "$staging" 2>/dev/null; then
        flock -u "$fd"
        exec {fd}>&-
        return 0
    fi
    : > "$queue"
    flock -u "$fd"
    exec {fd}>&-

    while IFS= read -r ip; do
        [[ -n $ip ]] || continue
        unban_ip "$ip"
    done < "$staging"
    rm -f "$staging"
}

# ---------------------------------------------------------------------------
# Ban state
#
# The kernel keeps the timeout of every element, but not across a reboot and
# not across a `nft flush ruleset` run by another tool. The daemon therefore
# records each ban with its absolute expiry in $STATE_FILE and restores the
# exact remaining time, instead of re-reading its own journal and handing out
# a fresh BAN_TIME to every address it finds there.
# ---------------------------------------------------------------------------

state_load() {
    local ip expiry
    BANS=()
    [[ -r $STATE_FILE ]] || return 1
    while IFS=' ' read -r ip expiry; do
        [[ -n $ip && -n $expiry ]] || continue
        is_valid_address "$ip" || continue
        [[ $expiry =~ ^[0-9]+$ ]] || continue
        BANS[$ip]=$expiry
    done < "$STATE_FILE"
    return 0
}

state_save() {
    local tmp=$STATE_FILE.tmp.$$ ip
    if ! : > "$tmp"; then
        return 1
    fi
    for ip in "${!BANS[@]}"; do
        printf '%s %s\n' "$ip" "${BANS[$ip]}" >> "$tmp"
    done
    if mv -f "$tmp" "$STATE_FILE"; then
        STATE_DIRTY=0
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# Drops the records the kernel has already expired, and the grace periods
# that are over. No nft call: the expiry recorded at ban time is the timeout
# handed to the kernel, so both end together.
prune_state() {
    local ip n
    n=$(now)
    for ip in "${!GRACE[@]}"; do
        (( ${GRACE[$ip]} <= n )) && unset "GRACE[$ip]"
    done
    for ip in "${!BANS[@]}"; do
        if (( ${BANS[$ip]} <= n )); then
            unset "BANS[$ip]"
            STATE_DIRTY=1
        fi
    done
}

restore_bans() {
    local ip expiry remaining

    mkdir -p "$STATE_DIR" 2>/dev/null
    chmod 700 "$STATE_DIR" 2>/dev/null

    if state_load; then
        log_event "[INFO] restoring bans from $STATE_FILE"
        for ip in "${!BANS[@]}"; do
            expiry=${BANS[$ip]}
            remaining=$(( expiry - $(now) ))
            if (( remaining <= 0 )); then
                unset "BANS[$ip]"
                STATE_DIRTY=1
                continue
            fi
            set_contains "$SET_V4" "$ip" && continue
            if nft add element inet "$TABLE_NAME" "$SET_V4" "{ $ip timeout ${remaining}s }" >/dev/null 2>&1; then
                log_event "[RESTORE] $ip (${remaining}s remaining)"
            else
                log_event "[WARN] failed to restore $ip"
            fi
        done
        (( STATE_DIRTY )) && state_save
        return 0
    fi

    # First start of this version: no state file yet, rebuild from the journal.
    log_event "[INFO] no state file yet, rebuilding bans from the journal"
    restore_bans_from_journal
}

restore_bans_from_journal() {
    local ip last_action
    while IFS= read -r ip; do
        [[ -n $ip ]] || continue
        is_whitelisted "$ip" && continue
        # Skip addresses whose most recent event was a manual unban.
        last_action=$(journalctl -q -t athena --grep "$ip" -n 1 --no-pager 2>/dev/null)
        [[ $last_action == *"[UNBAN]"* ]] && continue
        if ! set_contains "$SET_V4" "$ip"; then
            if nft add element inet "$TABLE_NAME" "$SET_V4" "{ $ip timeout ${BAN_TIME}s }" >/dev/null 2>&1; then
                log_event "[RESTORE] $ip (estimated remaining time)"
            fi
        fi
    done < <(journalctl -q -t athena --since "-${BAN_TIME} seconds" --no-pager 2>/dev/null \
             | grep -E '\[BAN\]|\[RESTORE\]' \
             | sed -nE 's/.*\[(BAN|RESTORE)\] ([0-9a-fA-F.:]+).*/\2/p' | sort -u)
}

# Everything that has to happen between two journal scans.
housekeeping() {
    process_unban_queue
    prune_state
    if (( STATE_DIRTY )); then
        state_save || log_event "[WARN] cannot write $STATE_FILE"
    fi
}

validate_config() {
    local v rc=0
    for v in THRESHOLD BAN_TIME FIND_TIME CHECK_INTERVAL; do
        if [[ ! ${!v} =~ ^[0-9]+$ ]]; then
            log_event "[ERROR] $v must be a positive integer (got '${!v}')"
            rc=1
        fi
    done
    (( THRESHOLD >= 1 )) || { log_event "[ERROR] THRESHOLD must be >= 1"; rc=1; }
    (( CHECK_INTERVAL >= 1 )) || { log_event "[ERROR] CHECK_INTERVAL must be >= 1"; rc=1; }
    if (( BAN_TIME < FIND_TIME )); then
        log_event "[WARN] BAN_TIME (${BAN_TIME}s) < FIND_TIME (${FIND_TIME}s): an address can be re-banned from stale log lines and stay blocked permanently"
    fi
    return "$rc"
}

load_config() {
    if [[ -r $CONF_FILE ]]; then
        # shellcheck source=/dev/null
        source "$CONF_FILE"
    elif [[ -r $FALLBACK_CONF ]]; then
        # shellcheck source=/dev/null
        source "$FALLBACK_CONF"
    else
        log_event "[ERROR] no configuration file found ($CONF_FILE, $FALLBACK_CONF)"
        return 1
    fi
}

main() {
    local opt ip
    for opt in "$@"; do
        case $opt in
            -v|--version) printf 'Athena Server Version %s\n' "$(athena_version)"; return 0 ;;
            -h|--help) printf 'Usage: athena-server [--version]\n'; return 0 ;;
        esac
    done

    if (( EUID != 0 )); then
        printf 'Erreur : ce script doit être exécuté en root.\n' >&2
        return 1
    fi

    load_config || return 1
    validate_config || return 1

    if ! command -v nft >/dev/null 2>&1; then
        log_event "[ERROR] nft not found in PATH"
        return 1
    fi
    if ! command -v journalctl >/dev/null 2>&1; then
        log_event "[ERROR] journalctl not found: Athena needs systemd-journald"
        return 1
    fi

    mkdir -p "$RUN_DIR"
    chmod 755 "$RUN_DIR"
    : >> "$RUN_DIR/unban_queue"
    chmod 644 "$RUN_DIR/unban_queue"

    log_event "[INFO] Athena Server started (version $(athena_version), backend: nftables)"
    init_firewall
    restore_bans

    trap '(( STATE_DIRTY )) && state_save; log_event "[INFO] Athena Server stopping"; exit 0' TERM INT
    while :; do
        housekeeping
        while IFS= read -r ip; do
            [[ -n $ip ]] || continue
            ban_ip "$ip"
        done < <(failed_sources)
        sleep "$CHECK_INTERVAL"
    done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
