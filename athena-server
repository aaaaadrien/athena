#!/usr/bin/env bash

# 1. Vérification des privilèges root
if [[ $EUID -ne 0 ]]; then
    echo "Erreur : ce script doit être exécuté en root." >&2
    exit 1
fi

# 2. Chargement de la configuration
if [ -f "/etc/athena/athena.conf" ]
then
    source /etc/athena/athena.conf
elif [ -f "./athena.conf" ]
then
    source ./athena.conf
else
    echo "Erreur : Fichier athena.conf introuvable." >&2
    exit 1
fi

# Valeurs par défaut si non définies dans la config
THRESHOLD=${THRESHOLD:-2}
BAN_TIME=${BAN_TIME:-3600}
FIND_TIME=${FIND_TIME:-600}
CHECK_INTERVAL=${CHECK_INTERVAL:-5}
WHITE_LIST=${WHITE_LIST:-"127.0.0.1"}
PORT_BLOCK=${PORT_BLOCK:-"all"}

# Variables internes
SET_NAME="athena_blacklist"
TABLE_NAME="athena"
UNBAN_QUEUE="/run/athena/unban_queue"

# Initialisation de l'environnement de travail
mkdir -p /run/athena
touch "$UNBAN_QUEUE"
chmod 644 "$UNBAN_QUEUE"

echo "--- Athena Server Démarré (Backend: nftables) ---"

# Convertit une adresse IP pointée en entier 32 bits
ip_to_int() {
    local a b c d
    IFS='.' read -r a b c d <<< "$1"
    echo $(( (a << 24) + (b << 16) + (c << 8) + d ))
}

# Vérifie si une IP appartient à un sous-réseau CIDR
ip_in_cidr() {
    local ip="$1" cidr="$2"
    if [[ "$cidr" != */* ]]; then
        [[ "$ip" == "$cidr" ]] && return 0 || return 1
    fi
    local net="${cidr%/*}"
    local prefix="${cidr#*/}"
    local ip_int net_int mask
    ip_int=$(ip_to_int "$ip")
    net_int=$(ip_to_int "$net")
    mask=$(( (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF ))
    [[ $(( ip_int & mask )) -eq $(( net_int & mask )) ]] && return 0
    return 1
}

# Vérifie si une IP est dans la liste blanche
is_whitelisted() {
    local ip="$1"
    for cidr in $WHITE_LIST; do
        ip_in_cidr "$ip" "$cidr" && return 0
    done
    return 1
}

# Initialise les tables et chaines nftables
init_firewall() {
    echo "Initialisation de nftables (Stratégie: $PORT_BLOCK)..."
    # 'nft add table' : Crée la table principale de type 'inet' (gère IPv4 et IPv6)
    nft add table inet $TABLE_NAME
    # 'nft add set' : Crée l'ensemble d'IPs bannies avec support des intervalles et du délai d'expiration (timeout)
    nft add set inet $TABLE_NAME $SET_NAME "{ type ipv4_addr; flags interval, timeout; }"
    # 'nft add chain' : Crée la chaine de filtrage des entrées avec une priorité très haute (-100)
    nft add chain inet $TABLE_NAME input "{ type filter hook input priority -100; policy accept; }"
    
    # 'nft flush chain' : Vide la chaine existante pour une réinitialisation propre des règles
    nft flush chain inet $TABLE_NAME input

    # Ajout de la règle de drop selon la configuration (ports spécifiques ou global)
    if [ "$PORT_BLOCK" = "all" ] || [ -z "$PORT_BLOCK" ]
    then
        # Bloque tout trafic provenant des IPs listées dans le set
        nft add rule inet $TABLE_NAME input ip saddr "@$SET_NAME" drop
    else
        # On remplace les virgules par des espaces pour le format nftables
        local PORTS_NFT=$(echo $PORT_BLOCK | sed 's/,/, /g')
        # Vérification sommaire que PORTS_NFT n'est pas vide pour éviter l'erreur de syntaxe { }
        if [[ -n "$PORTS_NFT" ]]
	then
            # 'nft add rule' : Bloque uniquement les ports TCP/UDP spécifiés pour les IPs bannies
            nft add rule inet $TABLE_NAME input ip saddr "@$SET_NAME" tcp dport "{ $PORTS_NFT }" drop
            nft add rule inet $TABLE_NAME input ip saddr "@$SET_NAME" udp dport "{ $PORTS_NFT }" drop
        else
            nft add rule inet $TABLE_NAME input ip saddr "@$SET_NAME" drop
        fi
    fi
    echo "Configuration nftables prête."
}

# Restaure les bannissements actifs depuis les logs système au démarrage
restore_bans() {
    echo "Restauration des bans depuis le journal..."
    # 'grep -oE' : Utilise une expression régulière pour extraire uniquement les adresses IPv4 valides des logs
    local PREVIOUS_BANS=$(journalctl -t athena --since "-${BAN_TIME} seconds" --no-pager 2>/dev/null \
        | grep -E "\[BAN\]|\[RESTORE\]" | grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}" | sort -u)

    for IP in $PREVIOUS_BANS; do
        if is_whitelisted "$IP"; then continue; fi
        
        # On vérifie si l'événement le plus récent pour cette IP n'est pas un déban
        local LAST_ACTION=$(journalctl -t athena --grep "$IP" -n 1 --no-pager 2>/dev/null)
        if [[ "$LAST_ACTION" == *"[UNBAN]"* ]]; then continue; fi

        # 'nft list set ... | grep -q' : Vérifie si l'IP est déjà présente dans le set nftables
        if ! nft list set inet $TABLE_NAME $SET_NAME | grep -q "$IP"
	then
            logger -t athena "[RESTORE] $IP (temps restant estimé)"
            # 'nft add element' : Réinsère l'IP dans le set avec son délai de bannissement
            nft add element inet $TABLE_NAME $SET_NAME "{ $IP timeout ${BAN_TIME}s }"
        fi
    done
}

# Lancement de la configuration initiale
init_firewall
restore_bans

# Boucle principale de surveillance
while true
do
    # 1. Traitement des demandes de débannissement manuel
    if [ -s "$UNBAN_QUEUE" ]
    then
        while IFS= read -r IP_TO_UNBAN
	do
            if [[ -n "$IP_TO_UNBAN" ]]
	    then
                # 'nft delete element' : Supprime manuellement une IP du set de bannissement
                if nft delete element inet $TABLE_NAME $SET_NAME "{ $IP_TO_UNBAN }" 2>/dev/null
		then
                    logger -t athena "[UNBAN] $IP_TO_UNBAN (Manuel)"
                fi
            fi
        done < "$UNBAN_QUEUE"
        > "$UNBAN_QUEUE"
    fi

    # 2. Détection des nouveaux échecs d'authentification SSH
    # On ne lit que les logs des N dernières secondes
    #  -t sshd-session au lieu de -u sshd car ça marche pas sur Debian
    NEW_BANS=$(journalctl -t sshd-session --since "-${FIND_TIME} seconds" --no-pager \
        | grep "Failed password" \
        | awk '{print $(NF-3)}' \
        | sort | uniq -c \
        | awk -v limit="$THRESHOLD" '$1 >= limit {print $2}')

    for IP in $NEW_BANS
    do
        # Validation du format d'IP via une expression régulière (Regex)
        if ! [[ "$IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then continue; fi
        if is_whitelisted "$IP"; then continue; fi
        
        # 'nft list set' : Vérifie la présence de l'IP avant ajout pour éviter les doublons
        if ! nft list set inet $TABLE_NAME $SET_NAME | grep -q "$IP"
	then
            logger -t athena "[BAN] $IP (pour ${BAN_TIME}s)"
            # 'nft add element' : Applique le bannissement réel dans le noyau via nftables
            nft add element inet $TABLE_NAME $SET_NAME "{ $IP timeout ${BAN_TIME}s }"
        fi
    done

    # Attente avant la prochaine vérification
    sleep "$CHECK_INTERVAL"
done
